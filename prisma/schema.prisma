generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Client {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  document  String?  // CPF/CNPJ
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  document  String?  // CPF/CNPJ
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
